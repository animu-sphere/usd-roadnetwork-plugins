  Hand-authored for usd-roadnetwork-plugins; no third-party content.
  A 3.5 m left lane 1 on an arc of radius 2 m, with lane 2 outside it: the
  border between them passes the center of curvature, so lane 2 is inverted
  (ADR 0004 section 2).
  Expected: RN-E308.
-->
<OpenDRIVE>
  <header revMajor="1" revMinor="8" name="inner-border" version="1.0" date="2026-11-22T00:00:00"/>
  <road name="a" length="10.0" id="1" junction="-1">
    <link/>
    <planView>
      <geometry s="0.0" x="0.0" y="0.0" hdg="0.0" length="10.0">
        <arc curvature="0.5"/>
      </geometry>
    </planView>
    <lanes>
      <laneSection s="0.0">
        <left>
          <lane id="2" type="sidewalk" level="false">
            <width sOffset="0.0" a="1.0" b="0.0" c="0.0" d="0.0"/>
          </lane>
          <lane id="1" type="driving" level="false">
            <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
          </lane>
        </left>
        <center>
          <lane id="0" type="none" level="false"/>
        </center>
        <right>
          <lane id="-1" type="driving" level="false">
            <width sOffset="0.0" a="3.5" b="0.0" c="0.0" d="0.0"/>
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
</OpenDRIVE>
