# OpenStrata and out-of-source build products. Anchored to the root; each
# workspace member's own .gitignore covers its directory.
/.strata/
/strata.lock
/strata.openstrata-*.lock
/build/
/dist/
/install/
/lib/
/out/

# CMake and Ninja products. Unanchored, so they are ignored at any depth:
# in-source configures of a library or bundle, IDE-managed build trees, and
# per-developer presets.
cmake-build-*/
CMakeUserPresets.json
CMakeLists.txt.user
compile_commands.json
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CTestTestfile.cmake
DartConfiguration.tcl
Testing/
_deps/
.cmake/
build.ninja
rules.ninja
.ninja_deps
.ninja_log
cmake_install.cmake
install_manifest.txt
Makefile

# Visual Studio generator products from an in-source configure.
*.sln
*.vcxproj
*.vcxproj.filters
*.dir/
x64/

# Python tooling and test caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Local editor, compiler-index, and OS metadata.
.vs/
.idea/
.cache/clangd/
*.suo
*.user
*.VC.db
*.VC.VC.opendb
.DS_Store
Thumbs.db
