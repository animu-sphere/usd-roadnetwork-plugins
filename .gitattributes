* text=auto

*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.in text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.usda text eol=lf
.clang-format text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# Road-network sources are XML. Keep them LF so fixture bytes, offsets in
# diagnostics, and golden comparisons are identical on every platform.
*.xodr text eol=lf
*.osm text eol=lf
*.xml text eol=lf

# Binary inputs that may enter later as fixtures (OSM PBF, compressed
# corpora). Never let text=auto guess.
*.pbf -text
*.gz -text
*.zip -text
*.usdc -text
*.usdz -text
