@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Both dependencies are guarded because a consumer has usually resolved them
# already: every bundle runs its own `if(NOT pxr_FOUND) find_package(pxr)`
# before requiring this library, and pxrConfig.cmake is not re-entrant (a
# second run fails re-creating its imported TBB target).
if(NOT TARGET openstrata::roadnetworkCore)
    find_dependency(roadnetworkCore)
endif()
if(NOT pxr_FOUND)
    find_dependency(pxr)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/roadnetworkUsdTargets.cmake")
check_required_components(roadnetworkUsd)
